DATABASE_URL=sqlite+aiosqlite:///./vac.db
SECRET_KEY=local-development-secret-key-change-me!!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DEBUG=true

# CORS 허용 오리진(쉼표 구분). 브라우저 클라이언트 도메인을 스킴/포트까지 정확히 적는다.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# 앱 기동 시 테이블 자동 생성 (운영은 Alembic 마이그레이션을 사용하므로 false)
AUTO_CREATE_TABLES=true

# ---- AWS (Lambda 배포 시 template.yaml 이 주입하므로 로컬에서는 비워둔다) ----
# DB_SECRET_ARN=
# DB_HOST=
# DB_NAME=
# JWT_SECRET_ARN=
